  "clauses": [
    {
      "code": "TONE-01",
      "category": "tone",
      "text": "Write in a professional, confident, plain-English voice. No slang, no emojis, and no exclamation marks in customer emails.",
      "do": [
        "We are happy to help."
      ],
      "dont": [
        "Hey guys!! This is super awesome lol"
      ]
    },
    {
      "code": "TONE-02",
      "category": "tone",
      "text": "Avoid generic filler phrases such as 'in today's fast-paced world' or 'unlock the power of'.",
      "do": [
        "Sync keeps your files identical on every device."
      ],
      "dont": [
        "In today's fast-paced world, unlock the power of Sync."
      ]
    },
    {
      "code": "TERM-01",
      "category": "terminology",
      "text": "Use 'Northbeam Sync' at first mention and 'Sync' afterwards. Never write 'NB Sync' or 'NorthbeamSync'.",
      "do": [
        "Northbeam Sync"
      ],
      "dont": [
        "NB Sync",
        "NorthbeamSync"
      ]
    },
    {
      "code": "CLAIM-01",
      "category": "promotional_claim",
      "text": "Do not use rankings or superlatives ('#1', 'best', 'leading', 'world-class') unless an approved fact supports them.",
      "do": [
        "Trusted by over 400 customers."
      ],
      "dont": [
        "India's #1 platform"
      ]
    },
    {
      "code": "CLAIM-02",
      "category": "promotional_claim",
      "text": "Do not describe service levels as guaranteed. Refer to the SLA instead.",
      "do": [
        "99.9% monthly uptime, backed by our SLA."
      ],
      "dont": [
        "99.99% uptime, guaranteed."
      ]
    },
    {
      "code": "CLAIM-03",
      "category": "promotional_claim",
      "text": "Customer counts, customer names and testimonials may be used only if an approved fact supports them.",
      "do": [
        "Over 400 customers"
      ],
      "dont": [
        "Used by 3 of the top 5 banks"
      ]
    },
    {
      "code": "VIS-01",
      "category": "visual",
      "text": "Use only brand palette colours (Navy, Teal, Sand, Charcoal, White, Coral).",
      "do": [],
