        "Pure red #FF0000"
      ]
    },
    {
      "code": "VIS-02",
      "category": "visual",
      "text": "Approved fonts: Sora for headings, Inter for body text. No other fonts.",
      "do": [
        "Sora",
        "Inter"
      ],
      "dont": [
        "Comic Sans MS"
      ]
    },
    {
      "code": "A11Y-01",
      "category": "accessibility",
      "text": "Text must meet WCAG 2.2 AA contrast (4.5:1, or 3:1 for large text). Every image needs meaningful alt text.",
